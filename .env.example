# SAP GenAI Incident Assistant
# Copy to .env for local development only.
# DOOO NOOOT commit .env or AWS credentials.

APP_NAME="SAP GenAI Incident Assistant"
ENVIRONMENT="local"
LOG_LEVEL="INFO"

# AWS
AWS_REGION="us-east-1"

# Amazon Bedrock
# Select a model/inference profile available in the target AWS account and Region.
BEDROCK_MODEL_ID=""
BEDROCK_KNOWLEDGE_BASE_ID=""
BEDROCK_DATA_SOURCE_ID=""

# Retrieval / grounding
RETRIEVAL_TOP_K="5"
MIN_RETRIEVAL_SCORE="0.60"

# Confidence gate
CONFIDENCE_HIGH_THRESHOLD="0.80"
CONFIDENCE_MEDIUM_THRESHOLD="0.60"

# SAP POC
SAP_MODULE="MM"
USE_MOCK_SAP="true"
MOCK_DATA_PATH="mock_data"

# Audit
ENABLE_AUDIT_LOGGING="true"
DYNAMODB_TABLE="sap-genai-assistant-audit"

# Streamlit
STREAMLIT_SERVER_PORT="8501"
